# Supabase — populate once real backend integration begins.
# See src/lib/supabase-client.ts. Mock UI/data flows do not read these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The app's own public base URL — never a Supabase URL. Resolved through
# the one shared helper, src/lib/server/app-base-url.ts
# (getAppBaseUrl/requireAppBaseUrl) — never read directly from
# process.env anywhere else. Used to build every absolute link this app
# generates outside a browser's own window.location: invite-user-action.ts's
# "Generate invite link"/invite/reset links, and notification-email.ts's
# "View ticket"/"Review request" CTA links in transactional emails.
#
# Local development: http://localhost:3000 (or whatever port `next dev`
# actually runs on locally). If this var is left unset entirely on a
# machine that isn't a real Vercel deployment, app-base-url.ts falls back
# to http://localhost:3000 on its own — that fallback exists for local
# dev only and is never used on Vercel (see app-base-url.ts's own
# VERCEL_ENV check), so it can never leak into a real email.
#
# Vercel Production Environment Variable — set exactly this, for the
# Production environment specifically (not just Preview/Development):
#   NEXT_PUBLIC_APP_URL=https://jirita.techtivo.com
# No trailing slash (app-base-url.ts strips one if present, but configure
# it clean). This is the only source app-base-url.ts ever uses for the
# production domain — it deliberately never infers one from Vercel's own
# VERCEL_URL or from request headers, since either could resolve to a
# Preview deployment's own *.vercel.app domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — never prefix with NEXT_PUBLIC_. Used exclusively by
# src/lib/server/invite-user-action.ts (a Server Action) to send real
# invite emails and provision profiles/organization_memberships via the
# Supabase Auth Admin API. Get it from Project Settings → API → service_role.
# Never commit the real value; never reference it from a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=

# NOTE — Supabase Auth email: JIRITA's Supabase-hosted system email (the
# invite-by-email path above, and Forgot Password's resetPasswordForEmail
# in src/lib/auth.ts) always goes out as whatever Sender Email/Sender Name
# is configured under Project Settings → Authentication → SMTP Settings
# (Custom SMTP) in the Supabase Dashboard — there is no env var for this;
# nothing in this repo's code sets a "from" address for that path. That
# Custom SMTP setting should point at the same SendGrid account/sender as
# JIRITA_EMAIL_FROM_ADDRESS/JIRITA_EMAIL_FROM_NAME below (never a second
# provider or a second SendGrid sender) — see
# docs/SUPABASE_AUTH_EMAIL_SETUP.md for the exact Dashboard steps
# (Custom SMTP fields + the JIRITA-branded Reset Password template), which
# must be applied by hand in the Dashboard — this repo has no
# supabase/config.toml or Management API access to apply it from code.

# SendGrid Web API — transactional email infrastructure, src/lib/email-sender.ts
# (sendTransactionalEmail). Server-only; never prefix with NEXT_PUBLIC_,
# never reference from a "use client" file. Wired to: immediate email for
# ticket_assigned/comment_mention/comment_reply/project_access_requested
# (src/lib/server/notification-email.ts) and the digest worker
# (src/lib/server/run-email-digest.ts).
# Get the API key from Twilio SendGrid → Settings → API Keys.
SENDGRID_API_KEY=
# Must be a sender verified in SendGrid for the jirita.techtivo.com domain.
JIRITA_EMAIL_FROM_ADDRESS=no-reply@jirita.techtivo.com
# Falls back to "JIRITA" if unset — the only field in this block allowed a
# non-secret default; explicit config is still preferred.
JIRITA_EMAIL_FROM_NAME=JIRITA

# Server-only — never prefix with NEXT_PUBLIC_. Authenticates requests to
# /api/cron/email-digest (src/app/api/cron/email-digest/route.ts), the
# hourly digest worker endpoint. Triggered by a Supabase pg_cron + pg_net
# job (see supabase/migrations/20260930060000_add_email_digest_cron_scheduler.sql),
# not Vercel Cron (Hobby plan only allows once-daily schedules). This
# value must be set in TWO places, and must be the exact same value in
# both:
#   1. Here / as a Vercel Production Environment Variable — read by
#      route.ts to validate the incoming request.
#   2. In Supabase Vault, as a secret named `jirita_cron_secret` — read by
#      the pg_cron job at run time to build the Authorization header it
#      sends. This is a one-time manual step in the Supabase SQL Editor
#      (never in Git — see the migration file's own header for the exact
#      statement); this env file cannot hold it, since Postgres reads
#      Vault, not this app's environment.
# Without CRON_SECRET configured here, every request to that endpoint is
# rejected with 401 (fails closed) — it never falls back to accepting
# unauthenticated requests. Generate a real value with e.g.:
# openssl rand -hex 32
CRON_SECRET=

# GitHub OAuth — Repository Integration's real "Connect GitHub" flow
# (src/app/api/integrations/github/connect|callback/route.ts,
# src/lib/server/github-repository-connection*.ts). Server-only; never
# prefix with NEXT_PUBLIC_, never reference from a "use client" file.
#
# From a GitHub OAuth App (github.com/settings/developers → OAuth Apps →
# New OAuth App): Homepage URL = ${NEXT_PUBLIC_APP_URL}, Authorization
# callback URL = ${NEXT_PUBLIC_APP_URL}/api/integrations/github/callback.
#
# NOTE: this is intentionally GITHUB_CLIENT_ID/GITHUB_CLIENT_SECRET, not
# GITHUB_OAUTH_CLIENT_ID/GITHUB_OAUTH_CLIENT_SECRET — matches the names
# actually used elsewhere in this environment's own .env.local; the code
# reads exactly these two.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/integrations/github/callback

# AES-256-GCM key for encrypting a connected GitHub account's access token
# at rest (project_repository_connections.access_token_ciphertext/_iv/
# _auth_tag — see src/lib/server/github-token-crypto.ts). Must be base64
# and decode to exactly 32 bytes, e.g.: openssl rand -base64 32
GITHUB_TOKEN_ENCRYPTION_KEY=
